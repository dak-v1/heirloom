{
  "name": "heirloom",
  "private": true,
  "version": "0.1.0",
  "description": "Heirloom — a mobile-first Singapore heritage web app. See the past, hear the stories, leave your mark.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:https": "vite --host --mode https",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/assets/build-all.mjs",
    "assets:2d": "node scripts/assets/build-2d.mjs",
    "assets:3d": "node scripts/assets/build-3d.mjs && node scripts/assets/build-world-globe.mjs && node scripts/assets/build-memory-tube.mjs && node scripts/assets/build-memory-jar.mjs",
    "narration": "node scripts/generate-narration.mjs",
    "media:vendor": "node scripts/vendor-media.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "express": "5.3.0",
    "leaflet": "1.9.4",
    "lucide-react": "0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "@fontsource/noto-serif-sc": "5.3.0",
    "@fontsource/noto-serif-tamil": "5.3.0",
    "@gltf-transform/core": "4.5.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/leaflet": "1.9.22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "harfbuzzjs": "1.6.3",
    "jpeg-js": "0.4.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
