# Copy to .env and fill in. Never commit real values.
# Server port for the API (the Vite dev server proxies /api here).
PORT=8787
# Moderation token for /api/admin/* (memory approval). Use a long random string.
HEIRLOOM_ADMIN_TOKEN=
# Secret used to sign guest tokens. Use a long random string.
HEIRLOOM_GUEST_SECRET=
# Optional: ElevenLabs narration pre-generation (scripts/generate-narration.mjs only; never exposed to the browser).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
